#!/bin/sh

## DO NOT COMMIT YOUR CREDENTIALS
## Copy to initialize_secrets.sh (gitignored) and fill in your own values.
## Runs inside the VM on every boot via provision/30-user-profile.sh.
##
## Azure is not configured here on purpose: log in interactively with
## `az login --use-device-code` (see README "Logging in to Azure").

cd

## Setup SSH (GitHub)
## 700 because it holds a private key
mkdir -p .ssh
chmod 700 .ssh

cat << 'EOF' > .ssh/id_rsa
-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----
EOF
chmod 600 .ssh/id_rsa

cat << 'EOF' > ~/.ssh/config
Host github.com
	Hostname github.com
	IdentityFile ~/.ssh/id_rsa
EOF

## Setup Git identity
## The VM is rebuilt from scratch, so git has no identity unless it's set here
git config --global user.name "USERNAME"
git config --global user.email "EMAIL"

## Optional: Terraform Cloud / HCP Terraform token
## Only needed if your Terraform uses a `cloud {}` block or remote backend on
## app.terraform.io. Uncomment and fill in if so.
# mkdir -p .terraform.d
# cat << 'EOF' > .terraform.d/credentials.tfrc.json
# {
#   "credentials": {
#     "app.terraform.io": {
#       "token": "YOUR_TERRAFORM_TOKEN"
#     }
#   }
# }
# EOF
